
rec vec {
	x:fd,
	y:fd,
}

rec quat {
	s:fd,
	v:fd,
}

fn main() {
	var x:fd12 = 0.44;
	var y:fd12 = 0.01;

	var p = vec {x:x, y:y};
	var q = vec {x:1.5, y:2.6};

	if x < y {
		x = y;
	} else {
		y = x;
	}

	fn vmul(a:vec, b:vec) -> quat {
		quat {
			s: a.x * b.x + a.y * b.y,
			v: a.x * b.y - b.x * a.y,
		}
	}

	vmul(p, q)
}

main()

